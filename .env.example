APP_NAME="Sam AI"
HOST=0.0.0.0
PORT=8000
DEBUG=True

# CORS Configuration (comma-separated domains or * for all)
CORS_ORIGINS="*"

# MongoDB Configuration (MongoDB Atlas or self-hosted)
# Option 1: Full Connection URI
MONGO_URI=mongodb+srv://<db_username>:<db_password>@ai-data.jkjhbcq.mongodb.net/?retryWrites=true&w=majority

# Option 2: Individual variables (used if MONGO_URI is not provided)
MONGO_HOST=ai-data.jkjhbcq.mongodb.net
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_DB_NAME=sam_ai_db
MONGO_IS_SRV=True

# Ollama & Embedding Configuration
OLLAMA_HOST=localhost
OLLAMA_PORT=11434
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
VECTOR_INDEX_NAME=chunks_vector_index

# LLM Generative Settings
LLM_PROVIDER=ollama
LLM_MODEL=qwen2.5:3b
LLM_BASE_URL=http://localhost:11434
LLM_API_KEY=
LLM_TEMPERATURE=0.3
LLM_MAX_TOKENS=4096
LLM_TIMEOUT=90.0
